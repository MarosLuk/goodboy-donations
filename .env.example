# Base URL of the assignment API. A trailing slash is stripped when it is read.
NEXT_PUBLIC_API_BASE_URL=https://frontend-assignment-api.goodrequest.dev

# Canonical site url, used as metadataBase so og:image resolves absolutely.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional "<contribution>/<contributors>". Set, the about page answers with these
# instead of calling the results endpoint, so the screen can be shown with the design's
# own figures rather than whatever the shared demo database currently holds. Leave it
# unset anywhere the real total is the point — these are the sums a visitor is asked to
# add to.
# NEXT_PUBLIC_DEMO_RESULTS=12200/1028
